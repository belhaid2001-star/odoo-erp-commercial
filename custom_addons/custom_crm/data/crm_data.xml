<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================ -->
    <!-- Étapes du pipeline BTP – noupdate="0" pour mise à jour           -->
    <!-- ================================================================ -->
    <data noupdate="0">
        <record id="stage_qualification" model="crm.stage">
            <field name="name">Nouvelle demande</field>
            <field name="sequence">10</field>
            <field name="is_won" eval="False"/>
            <field name="fold" eval="False"/>
        </record>

        <record id="stage_qualifie" model="crm.stage">
            <field name="name">Qualifié</field>
            <field name="sequence">20</field>
            <field name="is_won" eval="False"/>
            <field name="fold" eval="False"/>
        </record>

        <record id="stage_visite_programmee" model="crm.stage">
            <field name="name">Visite programmée</field>
            <field name="sequence">30</field>
            <field name="is_won" eval="False"/>
            <field name="fold" eval="False"/>
        </record>

        <record id="stage_visite_effectuee" model="crm.stage">
            <field name="name">Visite effectuée</field>
            <field name="sequence">40</field>
            <field name="is_won" eval="False"/>
            <field name="fold" eval="False"/>
        </record>

        <record id="stage_devis_envoye" model="crm.stage">
            <field name="name">Devis envoyé</field>
            <field name="sequence">50</field>
            <field name="is_won" eval="False"/>
            <field name="fold" eval="False"/>
        </record>

        <record id="stage_negociation" model="crm.stage">
            <field name="name">Négociation</field>
            <field name="sequence">60</field>
            <field name="is_won" eval="False"/>
            <field name="fold" eval="False"/>
        </record>

        <record id="stage_gagne" model="crm.stage">
            <field name="name">Gagné</field>
            <field name="sequence">70</field>
            <field name="is_won" eval="True"/>
            <field name="fold" eval="False"/>
        </record>

        <record id="stage_perdu" model="crm.stage">
            <field name="name">Perdu</field>
            <field name="sequence">80</field>
            <field name="is_won" eval="False"/>
            <field name="fold" eval="True"/>
        </record>

        <!-- Motifs de perte BTP -->
        <record id="crm_lost_reason_prix" model="crm.lost.reason">
            <field name="name">Prix trop élevé</field>
        </record>
        <record id="crm_lost_reason_delais" model="crm.lost.reason">
            <field name="name">Délais trop longs</field>
        </record>
        <record id="crm_lost_reason_concurrent" model="crm.lost.reason">
            <field name="name">Concurrent moins cher</field>
        </record>
        <record id="crm_lost_reason_technique" model="crm.lost.reason">
            <field name="name">Problème technique</field>
        </record>
        <record id="crm_lost_reason_annule" model="crm.lost.reason">
            <field name="name">Client annulé</field>
        </record>
        <record id="crm_lost_reason_autre" model="crm.lost.reason">
            <field name="name">Autre motif BTP</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- ============================================================ -->
        <!-- Type d'activité : WhatsApp                                    -->
        <!-- ============================================================ -->
        <record id="mail_activity_type_whatsapp" model="mail.activity.type">
            <field name="name">WhatsApp</field>
            <field name="icon">fa-whatsapp</field>
            <field name="delay_count">0</field>
            <field name="delay_unit">days</field>
            <field name="res_model"/>
            <field name="sequence">5</field>
            <field name="category">default</field>
        </record>

        <!-- Type d'activité : Appel téléphonique (précis) -->
        <record id="mail_activity_type_appel" model="mail.activity.type">
            <field name="name">Appel téléphonique</field>
            <field name="icon">fa-phone</field>
            <field name="delay_count">0</field>
            <field name="delay_unit">days</field>
            <field name="res_model"/>
            <field name="sequence">6</field>
        </record>

        <!-- Type d'activité : Email de relance -->
        <record id="mail_activity_type_relance_email" model="mail.activity.type">
            <field name="name">Email de relance</field>
            <field name="icon">fa-envelope</field>
            <field name="delay_count">3</field>
            <field name="delay_unit">days</field>
            <field name="res_model"/>
            <field name="sequence">7</field>
        </record>

        <!-- Type d'activité : Démonstration produit -->
        <record id="mail_activity_type_demo" model="mail.activity.type">
            <field name="name">Démonstration / Présentation</field>
            <field name="icon">fa-desktop</field>
            <field name="delay_count">7</field>
            <field name="delay_unit">days</field>
            <field name="res_model"/>
            <field name="sequence">8</field>
        </record>

    </data>

    <!-- Action concurrents -->
    <record id="action_crm_competitor" model="ir.actions.act_window">
        <field name="name">Concurrents</field>
        <field name="res_model">crm.competitor</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ajoutez vos concurrents
            </p>
            <p>
                Suivez les concurrents sur vos opportunités pour mieux
                adapter votre stratégie commerciale.
            </p>
        </field>
    </record>

    <!-- Vue formulaire concurrent -->
    <record id="view_crm_competitor_form" model="ir.ui.view">
        <field name="name">crm.competitor.form</field>
        <field name="model">crm.competitor</field>
        <field name="arch" type="xml">
            <form string="Concurrent">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du concurrent"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="website" widget="url"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Analyse">
                            <group>
                                <field name="strength" placeholder="Points forts du concurrent..."/>
                            </group>
                            <group>
                                <field name="weakness" placeholder="Points faibles du concurrent..."/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Notes diverses..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste concurrent -->
    <record id="view_crm_competitor_tree" model="ir.ui.view">
        <field name="name">crm.competitor.tree</field>
        <field name="model">crm.competitor</field>
        <field name="arch" type="xml">
            <tree string="Concurrents">
                <field name="name"/>
                <field name="website"/>
            </tree>
        </field>
    </record>
</odoo>
