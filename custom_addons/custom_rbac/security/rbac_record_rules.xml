<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Agent de Stock : acces complet a toutes les operations de stock -->
        <record id="rule_stock_picking_agent" model="ir.rule">
            <field name="name">Agent de Stock : acces aux transferts</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('custom_rbac.group_stock_agent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Comptable : interdit de supprimer les ecritures validees -->
        <record id="rule_account_move_comptable_no_delete" model="ir.rule">
            <field name="name">Comptable : interdit supprimer ecritures validees</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[('state', '!=', 'posted')]</field>
            <field name="groups" eval="[(4, ref('custom_rbac.group_comptable'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Commercial : opportunites de son equipe uniquement -->
        <record id="rule_crm_lead_commercial" model="ir.rule">
            <field name="name">Commercial : opportunites de son equipe</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">[
                '|',
                '|',
                ('user_id', '=', user.id),
                ('team_id.member_ids', 'in', [user.id]),
                ('team_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('custom_rbac.group_commercial'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
