<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Menu racine : Intelligence Artificielle (icone dans la barre  -->
    <!-- de navigation principale d'Odoo)                             -->
    <!-- ============================================================ -->
    <menuitem
        id="menu_ai_root"
        name="Mohasib IA"
        sequence="95"
        web_icon="custom_ai,static/description/icon.png"/>

    <!-- ============================================================ -->
    <!-- Sous-menus                                                    -->
    <!-- ============================================================ -->

    <!-- Consultation libre : ouvre le wizard IA sans contexte metier -->
    <record id="action_ai_wizard_global" model="ir.actions.act_window">
        <field name="name">Assistant IA</field>
        <field name="res_model">ai.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_module_name': 'general', 'default_action_type': 'btp_conseil'}</field>
    </record>

    <menuitem
        id="menu_ai_consultation"
        name="Assistant IA"
        parent="menu_ai_root"
        action="action_ai_wizard_global"
        sequence="10"/>

    <!-- Configuration IA (Parametres systeme, admin uniquement) -->
    <menuitem
        id="menu_ai_settings"
        name="Configuration"
        parent="menu_ai_root"
        action="base_setup.action_general_configuration"
        sequence="20"
        groups="base.group_system"/>

</odoo>
