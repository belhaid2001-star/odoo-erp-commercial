<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Dossiers par défaut -->
        <record id="folder_general" model="document.folder">
            <field name="name">Général</field>
            <field name="sequence">1</field>
            <field name="description">Documents généraux de l'entreprise</field>
        </record>

        <record id="folder_contracts" model="document.folder">
            <field name="name">Contrats</field>
            <field name="sequence">2</field>
            <field name="description">Contrats clients et fournisseurs</field>
        </record>

        <record id="folder_hr" model="document.folder">
            <field name="name">Ressources Humaines</field>
            <field name="sequence">3</field>
            <field name="description">Documents RH et employés</field>
        </record>

        <record id="folder_finance" model="document.folder">
            <field name="name">Finance</field>
            <field name="sequence">4</field>
            <field name="description">Documents comptables et financiers</field>
        </record>

        <record id="folder_legal" model="document.folder">
            <field name="name">Juridique</field>
            <field name="sequence">5</field>
            <field name="description">Documents juridiques et réglementaires</field>
        </record>

        <!-- Étiquettes par défaut -->
        <record id="tag_important" model="document.tag">
            <field name="name">Important</field>
            <field name="color">1</field>
        </record>

        <record id="tag_urgent" model="document.tag">
            <field name="name">Urgent</field>
            <field name="color">4</field>
        </record>

        <record id="tag_confidentiel" model="document.tag">
            <field name="name">Confidentiel</field>
            <field name="color">9</field>
        </record>

        <record id="tag_a_signer" model="document.tag">
            <field name="name">À signer</field>
            <field name="color">3</field>
        </record>

        <record id="tag_archiver" model="document.tag">
            <field name="name">À archiver</field>
            <field name="color">6</field>
        </record>

        <!-- ============================================================
             DOCUMENTS DE DÉMONSTRATION — Contexte BTP Maroc
        ============================================================ -->

        <!-- 1. Contrat sous-traitance -->
        <record id="demo_doc_contrat_st" model="document.document">
            <field name="name">Contrat de sous-traitance — Al Omrane Developpement</field>
            <field name="folder_id" ref="folder_contracts"/>
            <field name="document_type">contract</field>
            <field name="state">validated</field>
            <field name="version">1</field>
            <field name="expiration_date">2026-12-31</field>
            <field name="notes">Contrat de sous-traitance pour la réalisation des travaux de gros œuvre du projet Résidence Al Farah à Casablanca. Montant global : 2 500 000 MAD HT. Durée des travaux : 8 mois.</field>
            <field name="file" type="base64"></field>
            <field name="file_name">contrat_sous_traitance_al_omrane.txt</field>
            <field name="tag_ids" eval="[(4, ref('tag_important'))]"/>
        </record>

        <!-- 2. Devis chantier -->
        <record id="demo_doc_devis_chantier" model="document.document">
            <field name="name">Devis Chantier — Immeuble R+5 Hay Riad Rabat</field>
            <field name="folder_id" ref="folder_general"/>
            <field name="document_type">report</field>
            <field name="state">validated</field>
            <field name="version">2</field>
            <field name="notes">Devis détaillé pour la construction d'un immeuble R+5 à Hay Riad Rabat. Surface totale : 1 200 m². Coût estimatif : 4 800 000 MAD TTC. Ce document est la version finale approuvée par le maître d'ouvrage.</field>
            <field name="file" type="base64"></field>
            <field name="file_name">devis_chantier_hay_riad_rabat.txt</field>
            <field name="tag_ids" eval="[(4, ref('tag_important')), (4, ref('tag_a_signer'))]"/>
        </record>

        <!-- 3. Facture fournisseur Holcim -->
        <record id="demo_doc_facture_holcim" model="document.document">
            <field name="name">Facture Holcim Maroc — Ciment CPJ 45 — Avril 2026</field>
            <field name="folder_id" ref="folder_finance"/>
            <field name="document_type">invoice</field>
            <field name="state">validated</field>
            <field name="version">1</field>
            <field name="notes">Facture d'achat de ciment CPJ 45 pour le chantier Hay Riad. Quantité : 500 sacs x 85 MAD = 42 500 MAD HT. TVA 20% : 8 500 MAD. Total TTC : 51 000 MAD.</field>
            <field name="file" type="base64"></field>
            <field name="file_name">facture_holcim_avril_2026.txt</field>
            <field name="tag_ids" eval="[(4, ref('tag_confidentiel'))]"/>
        </record>

        <!-- 4. Attestation CNSS employé -->
        <record id="demo_doc_cnss" model="document.document">
            <field name="name">Attestation CNSS — Mohamed Alami — 2026</field>
            <field name="folder_id" ref="folder_hr"/>
            <field name="document_type">certificate</field>
            <field name="state">validated</field>
            <field name="version">1</field>
            <field name="expiration_date">2026-12-31</field>
            <field name="notes">Attestation d'affiliation CNSS et AMO pour l'employé Mohamed Alami. Numéro CNSS : 123456789. Attestation valide pour l'année 2026.</field>
            <field name="file" type="base64"></field>
            <field name="file_name">attestation_cnss_mohamed_alami_2026.txt</field>
            <field name="tag_ids" eval="[(4, ref('tag_important'))]"/>
        </record>

        <!-- 5. Registre de commerce -->
        <record id="demo_doc_rc" model="document.document">
            <field name="name">Registre de Commerce — Construction SARL</field>
            <field name="folder_id" ref="folder_legal"/>
            <field name="document_type">certificate</field>
            <field name="state">validated</field>
            <field name="version">1</field>
            <field name="expiration_date">2027-06-30</field>
            <field name="notes">Extrait du Registre de Commerce de la société Construction SARL. Tribunal de Commerce de Casablanca. Numéro RC : 123456. Date de création : 01/01/2020.</field>
            <field name="file" type="base64"></field>
            <field name="file_name">registre_commerce_construction_sarl.txt</field>
            <field name="tag_ids" eval="[(4, ref('tag_confidentiel'))]"/>
        </record>

        <!-- 6. Procédure sécurité chantier -->
        <record id="demo_doc_securite" model="document.document">
            <field name="name">Procédure Sécurité Chantier — Plan HSE 2026</field>
            <field name="folder_id" ref="folder_general"/>
            <field name="document_type">procedure</field>
            <field name="state">validated</field>
            <field name="version">3</field>
            <field name="notes">Plan Hygiène Sécurité Environnement pour les chantiers. Obligations légales : port des EPI, formation des ouvriers, registre des accidents. Mis à jour en avril 2026 selon les normes ONHYM et Code du Travail marocain.</field>
            <field name="file" type="base64"></field>
            <field name="file_name">plan_hse_chantier_2026.txt</field>
        </record>

    </data>
</odoo>
