<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- Localisation : Français comme langue système par défaut       -->
        <!-- ============================================================ -->
        <record id="lang_fr" model="res.lang">
            <field name="name">French / Français</field>
            <field name="code">fr_FR</field>
            <field name="iso_code">fr</field>
            <field name="active" eval="True"/>
            <field name="date_format">%d/%m/%Y</field>
            <field name="time_format">%H:%M:%S</field>
            <field name="decimal_point">,</field>
            <field name="thousands_sep"> </field>
            <field name="grouping">[3,0]</field>
            <field name="direction">ltr</field>
        </record>

        <!-- ============================================================ -->
        <!-- Devise : Dirham Marocain (MAD) comme devise par défaut        -->
        <!-- ============================================================ -->
        <record id="base.MAD" model="res.currency">
            <field name="name">MAD</field>
            <field name="full_name">Dirham Marocain</field>
            <field name="symbol">DH</field>
            <field name="position">after</field>
            <field name="active" eval="True"/>
            <field name="rounding">0.01</field>
            <field name="decimal_places">2</field>
        </record>

        <!-- Activer EUR comme devise secondaire -->
        <record id="base.EUR" model="res.currency">
            <field name="active" eval="True"/>
        </record>

        <!-- Activer USD comme devise secondaire -->
        <record id="base.USD" model="res.currency">
            <field name="active" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- Société principale : Maroc, langue FR, devise MAD             -->
        <!-- ============================================================ -->
        <record id="base.main_company" model="res.company">
            <field name="currency_id" ref="base.MAD"/>
            <field name="country_id" ref="base.ma"/>
            <field name="phone">+212</field>
        </record>

        <!-- ============================================================ -->
        <!-- Utilisateur admin : langue française                          -->
        <!-- ============================================================ -->
        <record id="base.user_admin" model="res.users">
            <field name="lang">fr_FR</field>
        </record>

        <!-- Langue par défaut pour les nouveaux utilisateurs -->
        <record id="base.user_root" model="res.users">
            <field name="lang">fr_FR</field>
        </record>

        <!-- ============================================================ -->
        <!-- Paramètre système : langue interface par défaut               -->
        <!-- ============================================================ -->
        <record id="system_param_lang" model="ir.config_parameter">
            <field name="key">lang</field>
            <field name="value">fr_FR</field>
        </record>

    </data>
</odoo>
