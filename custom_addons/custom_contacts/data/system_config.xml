<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- Devise : Dirham Marocain (MAD) par defaut -->
        <!-- ============================================================ -->
        <record id="base.MAD" model="res.currency">
            <field name="name">MAD</field>
            <field name="full_name">Dirham Marocain</field>
            <field name="symbol">DH</field>
            <field name="position">after</field>
            <field name="active" eval="True"/>
            <field name="rounding">0.01</field>
            <field name="decimal_places">2</field>
        </record>

        <!-- EUR devise secondaire -->
        <record id="base.EUR" model="res.currency">
            <field name="active" eval="True"/>
        </record>

        <!-- USD devise secondaire -->
        <record id="base.USD" model="res.currency">
            <field name="active" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- Societe principale : Maroc, langue FR, devise MAD             -->
        <!-- ============================================================ -->
        <record id="base.main_company" model="res.company">
            <field name="currency_id" ref="base.MAD"/>
            <field name="country_id" ref="base.ma"/>
            <field name="phone">+212</field>
        </record>

        <!-- Admin : langue francaise -->
        <record id="base.user_admin" model="res.users">
            <field name="lang">fr_FR</field>
        </record>

        <!-- Langue par defaut pour les nouveaux utilisateurs -->
        <record id="base.user_root" model="res.users">
            <field name="lang">fr_FR</field>
        </record>

        <!-- Parametre systeme : langue interface par defaut -->
        <record id="system_param_lang" model="ir.config_parameter">
            <field name="key">lang</field>
            <field name="value">fr_FR</field>
        </record>

    </data>
</odoo>
